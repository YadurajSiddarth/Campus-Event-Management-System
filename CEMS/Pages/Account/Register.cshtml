@page
@model CEMS.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Register"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">
                <h3 class="text-center mb-4"><i class="bi bi-person-plus me-2"></i>Register</h3>
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="FullName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="Password" class="form-control" required minlength="8" />
                        <div class="form-text">At least 8 characters with an uppercase letter, a lowercase letter and a digit.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="ConfirmPassword" class="form-control" required data-match="Password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" name="Department" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contact Number</label>
                        <input type="text" name="ContactNumber" class="form-control" maxlength="20" pattern="[0-9+\- ]{8,20}" title="Digits, spaces, + and - only" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Register</button>
                </form>
                <p class="text-center mt-3 mb-0">Already have an account? <a href="/Account/Login">Login</a></p>
            </div>
        </div>
    </div>
</div>

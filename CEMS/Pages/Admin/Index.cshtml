@page
@model CEMS.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Admin Dashboard"; }

<h2 class="mb-4"><i class="bi bi-shield-lock me-2"></i>Admin Dashboard</h2>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card text-center p-3 border-primary">
            <h3>@Model.Users.Count</h3><small class="text-muted">Total Users</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3 border-success">
            <h3>@Model.Users.Count(u => u.Role == "Student")</h3><small class="text-muted">Students</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3 border-warning">
            <h3>@Model.Users.Count(u => u.Role == "Staff")</h3><small class="text-muted">Staff / Organisers</small>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">User Management</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Action</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.UserId</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            <form method="post" style="display:inline">
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <select name="role" class="form-select form-select-sm d-inline-block" style="width:auto" onchange="this.form.submit()" disabled="@(u.UserId == Model.CurrentUserId)">
                                    @foreach (var r in new[] { "Student", "Staff", "Admin" })
                                    {
                                        <option value="@r" selected="@(u.Role == r)">@r</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td>@u.Department</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" style="display:inline" data-confirm="Delete this user?">
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(u.UserId == Model.CurrentUserId)"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

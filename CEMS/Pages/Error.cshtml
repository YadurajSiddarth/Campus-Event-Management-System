@page
@model ErrorModel
@{ ViewData["Title"] = "Error"; }

<div class="text-center py-5">
    <h1 class="display-6 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Something went wrong</h1>
    <p class="lead text-muted">An error occurred while processing your request. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn btn-primary">Back to Home</a>
</div>

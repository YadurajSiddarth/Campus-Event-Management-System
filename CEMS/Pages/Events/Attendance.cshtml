@page
@model CEMS.Pages.Events.AttendanceModel
@{ ViewData["Title"] = "Attendance"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Attendance</h2>
        <p class="text-muted mb-0">@Model.Event.Title &middot; @Model.Event.EventDate.ToString("dd MMM yyyy, hh:mm tt") &middot; <span class="badge bg-secondary">@Model.Event.Status</span></p>
    </div>
    <div>
        <a href="/Events/Detail?id=@Model.Event.EventId" class="btn btn-outline-secondary">Back to event</a>
        @if (Model.Event.Status == "Active")
        {
            <form method="post" asp-page-handler="Complete" asp-route-id="@Model.Event.EventId" class="d-inline" data-confirm="Mark this event as completed?">
                <button type="submit" class="btn btn-success">Mark Event Completed</button>
            </form>
        }
    </div>
</div>

@if (!Model.Participants.Any())
{
    <div class="alert alert-info">Nobody is registered for this event.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover bg-white align-middle">
            <thead class="table-primary">
                <tr><th>Participant</th><th>Email</th><th>Department</th><th>Remarks</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Participants)
                {
                    <tr>
                        <td>@r.User.FullName</td>
                        <td>@r.User.Email</td>
                        <td>@r.User.Department</td>
                        <td>@r.Remarks</td>
                        <td><span class="badge @(r.Status == "Attended" ? "bg-primary" : "bg-success")">@r.Status</span></td>
                        <td>
                            <form method="post" asp-page-handler="Mark" asp-route-id="@Model.Event.EventId">
                                <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                <input type="hidden" name="attended" value="@(r.Status == "Attended" ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm @(r.Status == "Attended" ? "btn-outline-secondary" : "btn-outline-primary")">@(r.Status == "Attended" ? "Undo" : "Mark attended")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

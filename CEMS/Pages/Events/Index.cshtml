@page
@model CEMS.Pages.Events.IndexModel
@using CEMS.Models
@{ ViewData["Title"] = "Events"; }

<h2 class="mb-3"><i class="bi bi-calendar3 me-2"></i>All Events</h2>

<form method="get" class="card card-body mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small mb-1">Keyword</label>
            <input type="text" name="search" class="form-control" placeholder="Title, description or venue" value="@Model.Search" />
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-1">Category</label>
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                @foreach (var c in EventCategories.All)
                {
                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-1">Organiser</label>
            <input type="text" name="organiser" class="form-control" placeholder="Organiser name" value="@Model.Organiser" />
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-1">From date</label>
            <input type="date" name="dateFrom" class="form-control" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-1">To date</label>
            <input type="date" name="dateTo" class="form-control" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>Search</button>
            <a href="/Events" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">No events match your search.</div>
}

<div class="row g-4">
    @foreach (var ev in Model.Events)
    {
        var isFull = ev.SeatsTaken >= ev.MaxSeats;
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span class="badge bg-info">@ev.Category</span>
                        <span class="badge @(ev.Status == "Active" ? "bg-success" : ev.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">@ev.Status</span>
                    </div>
                    <h5 class="card-title mt-2">@ev.Title</h5>
                    <p class="text-muted mb-1"><i class="bi bi-calendar me-1"></i>@ev.EventDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                    <p class="text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@ev.Venue</p>
                    <p class="text-muted mb-1"><i class="bi bi-person me-1"></i>@ev.Organiser.FullName</p>
                    <p class="text-muted mb-2"><i class="bi bi-people me-1"></i>@ev.SeatsTaken / @ev.MaxSeats seats @(isFull ? "(FULL)" : "")</p>
                    <p class="card-text small">@(ev.Description.Length > 120 ? ev.Description[..120] + "..." : ev.Description)</p>
                </div>
                <div class="card-footer bg-white">
                    <a href="/Events/Detail?id=@ev.EventId" class="btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
        </div>
    }
</div>

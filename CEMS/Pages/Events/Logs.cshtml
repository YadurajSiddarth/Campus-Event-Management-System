@page
@model CEMS.Pages.Events.LogsModel
@{ ViewData["Title"] = "Registration Logs"; }

<h2 class="mb-1"><i class="bi bi-journal-text me-2"></i>Registration Logs</h2>
<p class="text-muted">@Model.Scope (latest 200 entries).</p>

@if (!Model.Logs.Any())
{
    <div class="alert alert-info">No log entries yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped bg-white align-middle">
            <thead class="table-primary">
                <tr><th>When</th><th>Event</th><th>Participant</th><th>Action</th><th>Details</th><th>Changed by</th></tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Logs)
                {
                    var badge = l.Action switch { "Registered" => "bg-success", "Cancelled" => "bg-danger", "Updated" => "bg-warning text-dark", "Attended" => "bg-primary", _ => "bg-secondary" };
                    <tr>
                        <td>@l.LoggedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td><a href="/Events/Detail?id=@l.Registration.EventId">@l.Registration.Event.Title</a></td>
                        <td>@l.Registration.User.FullName</td>
                        <td><span class="badge @badge">@l.Action</span></td>
                        <td>@l.Details</td>
                        <td>@l.Actor.FullName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

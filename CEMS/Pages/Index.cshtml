@page
@model CEMS.Pages.IndexModel
@{ ViewData["Title"] = "Home"; }

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold text-primary"><i class="bi bi-calendar-event me-2"></i>Campus Event Management System</h1>
    <p class="lead text-muted">Discover, register, and manage campus events all in one place.</p>
    <a href="/Events" class="btn btn-primary btn-lg me-2"><i class="bi bi-search me-1"></i>Browse Events</a>
    @if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserName")))
    {
        <a href="/Account/Login" class="btn btn-outline-primary btn-lg">Login</a>
    }
</div>

<div class="row g-4">
    @foreach (var ev in Model.UpcomingEvents)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge bg-info mb-2">@ev.Category</span>
                    <h5 class="card-title">@ev.Title</h5>
                    <p class="text-muted mb-1"><i class="bi bi-calendar me-1"></i>@ev.EventDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                    <p class="text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@ev.Venue</p>
                    <p class="card-text small">@(ev.Description.Length > 100 ? ev.Description[..100] + "..." : ev.Description)</p>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                    <small class="text-muted">@ev.SeatsTaken / @ev.MaxSeats seats</small>
                    <a href="/Events/Detail?id=@ev.EventId" class="btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
        </div>
    }
</div>
